<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />

    <!-- Vehicle SDK: 조회·구독용 퍼미션만 선언합니다.
         CONTROL_CAR_* 제어 퍼미션은 App Market 사전 승인 없이 선언하면 심사를 통과할 수 없습니다. -->
    <uses-permission android:name="pleos.car.permission.CAR_DOORS" />
    <uses-permission android:name="pleos.car.permission.CAR_SEATS" />
    <uses-permission android:name="pleos.car.permission.CAR_LIGHTS" />
    <uses-permission android:name="pleos.car.permission.CAR_WINDOWS" />
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <uses-permission android:name="pleos.car.permission.CAR_ENERGY" />
    <uses-permission android:name="pleos.car.permission.CAR_CLIMATE" />
    <uses-permission android:name="pleos.car.permission.CAR_SAFETY" />
    <uses-permission android:name="pleos.car.permission.CAR_INFO" />

    <!-- NaviHelper SDK -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <!-- SpeechToText / TextToSpeech SDK -->
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />

    <!-- FusedLocation SDK (dangerous: 실행 중 요청 필요) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />

    <!-- AAOS 표준: 차속(dangerous), 기어 -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />
    <uses-permission android:name="android.car.permission.CAR_POWERTRAIN" />

    <!-- STT·TTS 서버 모드, 자체 서버 연동 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중에도 이야기 화면을 띄우므로 DO 선언. 화면은 CarUxRestrictions에 따라 기능을 제한한다. -->
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>

        <!-- 디버그용 SDK 신호 검증 화면 -->
        <activity android:name=".pleos.SdkCheckActivity" android:exported="true">
            <meta-data android:name="distractionOptimized" android:value="true" />
        </activity>
    </application>
</manifest>
